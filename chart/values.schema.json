{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "vkr-metachart values schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "imageRegistry": {
          "type": "string"
        },
        "imageTag": {
          "type": "string"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "profile": {
            "type": "string"
          },
          "replicaCount": {
            "type": "integer",
            "minimum": 0
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "image": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "pullPolicy": {
                "type": "string",
                "enum": [
                  "Always",
                  "IfNotPresent",
                  "Never",
                  ""
                ]
              }
            }
          },
          "service": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "ingress": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "pathType": {
                "type": "string"
              }
            }
          },
          "env": {
            "type": "object"
          },
          "config": {
            "type": "object"
          },
          "secrets": {
            "type": "object"
          },
          "dependencies": {
            "type": "object"
          },
          "networkPolicy": {
            "type": "object"
          },
          "monitoring": {
            "type": "object"
          },
          "serviceMesh": {
            "type": "object"
          }
        }
      }
    }
  }
}